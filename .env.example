# Variaveis de ambiente das funcoes serverless (api/).
#
# Este arquivo e so um modelo — os valores reais NAO ficam aqui nem no Git.
# Eles vao no painel da Vercel: Project > Settings > Environment Variables.
#
# Depois de criar ou mudar qualquer uma delas, e preciso um novo deploy
# (Deployments > ... > Redeploy) para que as funcoes enxerguem os valores.


# Access Token do Mercado Pago. SEGREDO — quem tem isso cobra no seu lugar.
# Painel do Mercado Pago > Suas integracoes > sua aplicacao > Credenciais.
# Tem que ser do MESMO ambiente da Public Key que esta em js/licenca.js:
# APP_USR-... aqui exige APP_USR-... la; TEST-... aqui exige TEST-... la.
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000

# URL do projeto Supabase (a mesma que esta em js/conta.js, nao e segredo).
SUPABASE_URL=https://lbbzrmvmezywmeghofzd.supabase.co

# Chave SECRETA do Supabase. Ela ignora as regras de RLS.
# Supabase > Project Settings > API Keys > secao "Secret keys" (sb_secret_...),
# ou, na aba "Legacy anon, service_role API keys", a service_role.
# NUNCA use essa chave no navegador; e so para as funcoes em api/.
# Cuidado: a chave publica fica logo acima na mesma tela e e parecida. Trocar
# uma pela outra faz o login funcionar e toda leitura de tabela voltar vazia.
# O codigo detecta esse engano e avisa, mas e melhor nao cair nele.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# OPCIONAL. Endereco publico do site, usado para montar a notification_url que
# o Mercado Pago chama. Se estiver ausente ou torto, o endereco sai dos
# cabecalhos da propria requisicao — que e o valor mais confiavel, porque
# ninguem digita. Se preencher, precisa do https:// na frente: sem ele o
# Mercado Pago recusa o pagamento inteiro.
SITE_URL=https://editorbg.vercel.app

# NAO EXISTE MAIS uma variavel de preco. Os tres planos (valor e duracao) moram
# em js/planos.js, que o navegador e o servidor importam do mesmo lugar — assim
# o preco mostrado na tela nao tem como divergir do cobrado. Para mudar um
# preco, edite js/planos.js e publique.
