# Variaveis de ambiente das funcoes serverless (api/).
#
# Este arquivo e so um modelo — os valores reais NAO ficam aqui nem no Git.
# Eles vao no painel da Vercel: Project > Settings > Environment Variables.
#
# Depois de criar ou mudar qualquer uma delas, e preciso um novo deploy
# (Deployments > ... > Redeploy) para que as funcoes enxerguem os valores.


# Access Token do Mercado Pago. SEGREDO — quem tem isso cobra no seu lugar.
# Painel do Mercado Pago > Suas integracoes > sua aplicacao > Credenciais.
# Tem que ser do MESMO ambiente da Public Key que esta em js/licenca.js:
# APP_USR-... aqui exige APP_USR-... la; TEST-... aqui exige TEST-... la.
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000

# URL do projeto Supabase (a mesma que esta em js/conta.js, nao e segredo).
SUPABASE_URL=https://lbbzrmvmezywmeghofzd.supabase.co

# Chave service_role do Supabase. SEGREDO — ela ignora as regras de RLS.
# Supabase > Project Settings > API > service_role.
# NUNCA use essa chave no navegador; e so para as funcoes em api/.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Endereco publico do site. Vira a notification_url que o Mercado Pago chama.
SITE_URL=https://editorbg.vercel.app

# Preco do VIP em reais. E este valor que o servidor cobra — o que o navegador
# manda e ignorado de proposito, senao daria para pagar R$ 0,01 e virar VIP.
PRECO_VIP=19.90
